# Obrigatórias
aws_region   = "us-east-1"
service_name = "resend"

# Mantenha 0 até gravar o valor inicial. A chave nunca vai neste arquivo:
# informe-a em TF_VAR_initial_secret, como descrito no README.
initial_secret_version = 0

# Ative só depois de a aplicação ler a chave do segredo.
enable_rotation   = false
rotation_schedule = "rate(30 days)"

# Opcionais
log_retention_days = 30
tags = {
  Environment = "production"
  ManagedBy   = "terraform"
  Project     = "nexuskey"
}
